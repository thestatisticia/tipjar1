# Private key of the deployer wallet (include the 0x prefix)
DEPLOYER_PRIVATE_KEY_HEX=0x<64_hex_characters>

# Celoscan API key for contract verification
CELOSCAN_API_KEY=your_celoscan_api_key_here

# Wallets enabled to review task and campaign submissions
TASK_ESCROW_ADMIN_WALLET=0x...
CAMPAIGN_ESCROW_ADMIN_WALLET=0x...
